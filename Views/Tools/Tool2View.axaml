<UserControl x:Class="RobotAIArm.Views.Tools.Tool2View"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:RobotAIArm.ViewModels.Tools"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="400"
             x:DataType="vm:Tool2ViewModel" x:CompileBindings="True">
	<Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">

		<TextBlock Grid.Row="0" Grid.Column="0" Text="Base Angle:" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
		<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BaseAngle}" FontSize="20" VerticalAlignment="Center"/>

		<TextBlock Grid.Row="1" Grid.Column="0" Text="Lower joint Angle:" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
		<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LowerJointAngle}" FontSize="20" VerticalAlignment="Center"/>

		<TextBlock Grid.Row="2" Grid.Column="0" Text="Middle joint Angle:" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
		<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MiddleJointAngle}" FontSize="20" VerticalAlignment="Center"/>

		<TextBlock Grid.Row="3" Grid.Column="0" Text="Upper joint Angle:" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
		<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UpperJointAngle}" FontSize="20" VerticalAlignment="Center"/>

	</Grid>
</UserControl>
